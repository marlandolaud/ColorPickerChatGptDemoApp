# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# Required: ngrok authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Required: set these from terraform output after provisioning
AZURE_TENANT_ID=
MCP_API_CLIENT_ID=
# The stable APIM gateway URL (no trailing slash), e.g. https://apim-mcp-poc.azure-api.net
MCP_PUBLIC_URL=
# terraform output chatgpt_client_id / terraform output -raw chatgpt_client_secret
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
# Random secret for HMAC-signing OAuth proxy state/codes — generate with: openssl rand -base64 32
OAUTH_PROXY_SECRET=
